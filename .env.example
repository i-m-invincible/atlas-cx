# Local development only. These are public example passwords, not production secrets.
# Keep local password overrides URL-safe; percent-encode passwords in explicit URLs.
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:8080
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Asia/Kolkata
WEB_PORT=8080
API_PORT=8000
DB_PORT=5432
POSTGRES_DB=atlas_cx
POSTGRES_USER=atlas_bootstrap
POSTGRES_PASSWORD=local-bootstrap-only
APP_DB_PASSWORD=local-app-only
MIGRATION_DB_PASSWORD=local-migration-only
QUEUE_DB_PASSWORD=local-queue-only

# For processes running on the host; Compose uses its private `db` hostname.
DATABASE_URL=postgresql+psycopg://atlas_app:local-app-only@localhost:5432/atlas_cx
MIGRATION_DATABASE_URL=postgresql+psycopg://atlas_migrator:local-migration-only@localhost:5432/atlas_cx

# Reserved by PRODUCT_SPEC section 15.2; queue/generation are not implemented.
# Do not supply migration/queue credentials to the API process.
QUEUE_DATABASE_URL=postgresql+psycopg://atlas_queue:local-queue-only@localhost:5432/atlas_cx
# Public development keys. Production rejects these values; use private random keys.
SESSION_SIGNING_KEY=local-development-session-key-change-before-hosting
CURSOR_SIGNING_KEY=local-development-cursor-key-change-before-hosting
DEMO_MODE=false
GENERATION_MODE=disabled
OLLAMA_BASE_URL=
GENERATION_MODEL_DIGEST=
EMBEDDING_MODEL_REVISION=
BACKUP_DESTINATION=
